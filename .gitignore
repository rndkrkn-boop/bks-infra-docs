matrix/
.claude/

# Артефакты комплаенс-аудита (публикуются как artifacts CI, не коммитятся)
.compliance-out/

# Байт-код тестов и скриптов
__pycache__/
.pytest_cache/
.ruff_cache/

# ── Носители секретов ────────────────────────────────────────────────────────
# Порядок значим: правило-исключение `!` действует только если стоит ПОСЛЕ
# правила, которое его перекрывает. `!.env.example` выше `.env.*` не работал бы
# вовсе, и шаблон переменных стал бы невидим для git.
#
# Требования этих строк проверяются машиной: rules.toml → SEC-002/SEC-101
# (scripts/compliance-audit.py), плюс pre-commit-гейт ci/guard-staged-secrets.sh.
.env
.env.*
!.env.example
*.pem
*.key

# Логи ежедневного цикла аудита: рабочие артефакты одного прогона, не история.
# Отчёты и одобрения того же каталога тоже не коммитятся — audits/ не входит
# в белый список путей `git add` в scripts/daily-verify*.sh.
audits/*.log
# stderr Claude-аудита и невалидный (не-JSON) сырой вывод — тот же принцип.
audits/*.stderr
audits/*-audit-report.raw.txt
