{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bks.invalid/schemas/approval.schema.json",
  "title": "Daily audit approval",
  "description": "Формат файла одобрения (APPROVAL_DIR/<дата>-approval.json), которым человек разрешает автономному циклу реализовать выбранные issue из отчёта аудита. Файл живёт вне репозитория (AUDIT-005) и проверяется scripts/verify-approval.py по схеме + HMAC-подписи перед стартом реализации.",
  "type": "object",
  "required": ["approval_date", "approved_issue_ids", "approved_issues", "signature"],
  "additionalProperties": true,
  "properties": {
    "approval_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Дата отчёта аудита, к которому относится одобрение. Должна совпадать с audit_date отчёта."
    },
    "approved_by": {
      "type": "string",
      "description": "Идентификатор одобрившего (необязательно, справочно)."
    },
    "approved_issue_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^AUDIT-\\d+[a-z]?$"
      }
    },
    "approved_issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/approved_issue" }
    },
    "signature": {
      "type": "string",
      "description": "HMAC-SHA256(hex) от JSON-объекта этого файла БЕЗ поля signature, сериализованного с sort_keys=True и compact-разделителями. Ключ — APPROVAL_HMAC_KEY из GitLab CI Variables.",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "definitions": {
    "approved_issue": {
      "type": "object",
      "required": ["id", "priority", "title", "implementation"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AUDIT-\\d+[a-z]?$"
        },
        "priority": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
