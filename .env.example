# Шаблон переменных окружения репозитория bks/infra.
#
# ЭТО ЕДИНСТВЕННЫЙ .env-файл, который коммитится (см. `!.env.example` в
# .gitignore). Значений здесь быть не должно — только имена и описание, откуда
# значение берётся. Проверяется машиной: scripts/compliance-audit.py, правило
# SEC-003 (compliance/rules.toml) — .env/*.key/*.pem не должны быть tracked,
# .env.example — разрешённое исключение.
#
# Канонический store секретов этого репозитория — защищённые GitLab CI/CD
# Variables (group `bks`). Локальный .env нужен только для ручного прогона
# скриптов на хосте и никогда не покидает машину.
#
# Порядок применения (от низшего приоритета к высшему):
#   .env.example  → только справка, не загружается
#   .env          → локальный, .gitignored
#   .env.local    → локальные переопределения, .gitignored
#   переменные окружения / CI Variables → высший приоритет

# ── Пути рабочего дерева ─────────────────────────────────────────────────────
# Корень репозитория для скриптов ежедневного цикла. Переопределяется в тестах,
# чтобы гейт автокоммита можно было прогнать на одноразовом репозитории.
PROJECT_DIR=/home/admin/projects/nemohermes_bks

# Каталог одобрений аудита. Вынесен ЗА пределы репозитория намеренно (AUDIT-005):
# файл одобрения — управляющий вход автономного цикла, ему нельзя быть
# редактируемым тем же коммитом, который он одобряет.
# Путь должен совпадать с APPROVAL_DIR в daily-audit.sh/daily-implement-now.sh/
# daily-cycle-orchestrator.sh — расхождение уже случалось (эта строка раньше
# указывала на несуществующий /home/admin/.bks-approvals, пока
# daily-audit.sh создавал и использовал /home/admin/approvals).
APPROVAL_DIR=/home/admin/approvals

# HMAC-ключ, которым подписывается файл одобрения (scripts/verify-approval.py).
# Канонически — GitLab CI Variable APPROVAL_HMAC_KEY; для ручного прогона на
# хосте нужен тот же ключ локально (см. ~/.bashrc). Без него verify-approval.py
# отказывает fail-closed — реализация не может начаться без подписи.
APPROVAL_HMAC_KEY=

# ── Комплаенс-аудит (scripts/compliance-audit.py, ci/compliance-report.sh) ───
# Куда складывать JSON/Markdown/метрики прогона. В CI задаётся джобой.
COMPLIANCE_OUT_DIR=.compliance-out
# Каталог textfile-экспозиции node-exporter для метрик комплаенса.
COMPLIANCE_METRICS_DIR=/var/lib/node_exporter/textfile_collector
# Фиксированная «сегодняшняя» дата для воспроизводимого прогона (YYYY-MM-DD).
COMPLIANCE_NOW=

# ── Конвейер метрик (scripts/metrics-bridge.py, ci/metrics-bridge.sh) ────────
METRICS_SOURCES=metrics/sources.toml
METRICS_OUT_DIR=/var/lib/node_exporter/textfile_collector
# 1 — падать на нечитаемом источнике вместо тихого пропуска.
METRICS_STRICT=0

# ── Версионированные бэкапы (scripts/backup-manager.py) ─────────────────────
BACKUP_ROOT=/srv/bks-backups

# ── GitLab / реестр образов ─────────────────────────────────────────────────
# Self-hosted GitLab CE. Хост не секрет, токен — секрет.
GITLAB_HOST=192.168.2.180:8929
# ЗНАЧЕНИЕ БРАТЬ ИЗ: GitLab → Settings → CI/CD → Variables (masked, protected).
# Никогда не вписывать сюда и не передавать аргументом командной строки.
GITLAB_TOKEN=<obtain from GitLab CI/CD Variables>
# Заполняются раннером автоматически; здесь только для справки.
CI_REGISTRY=
CI_REGISTRY_USER=
CI_REGISTRY_PASSWORD=<injected by GitLab Runner>

# ── Подпись образов (ci/cosign-lib.sh, ci/verify-image-sig.sh) ──────────────
COSIGN_VERSION=v2.4.1
# Приватный ключ и его пароль — ТОЛЬКО file-типом CI Variable, не текстом
# в этом файле и не путём в репозитории (*.key и *.pem gitignored).
COSIGN_KEY_FILE=<path to file-type CI Variable>
COSIGN_PASSWORD=<obtain from GitLab CI/CD Variables>
COSIGN_PUBKEY_FILE=<path to file-type CI Variable>

# ── Telegram-уведомления (daily-cycle-orchestrator.sh) ──────────────
# Токен Telegram-бота для отправки уведомлений о ежедневном цикле аудита.
# Получить: создать бота у @BotFather в Telegram, скопировать токен.
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN:-}

# Chat ID группы/канала для получения уведомлений о цикле.
# Узнать: добавить @userinfobot в группу и написать /start, он выдаст chat_id.
# Для приватных чатов — отрицательное число (например, -123456789).
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID:-}

# ── Прочее ──────────────────────────────────────────────────────────────────
# Организация зеркал git (ci/setup-git-mirrors.sh).
GITHUB_ORG=
